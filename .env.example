# Notion integration token (https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hike Planner database ID (the UUID part of the database URL)
NOTION_DATABASE_ID=c82a424a9fce4cbb86619401691900ba

# Optional: pin a specific data source ID. Leave unset to auto-discover
# from the database (works for single-source databases).
# NOTION_DATA_SOURCE_ID=f6bea52a-b6c6-4c8e-8887-34c6dde9327d

# Komoot account credentials
KOMOOT_EMAIL=you@example.com
KOMOOT_PASSWORD=your-komoot-password

# Origin for "Drive Time from NYC" calculation. Defaults to Manhattan.
# DRIVE_ORIGIN_LAT=40.7128
# DRIVE_ORIGIN_LON=-74.0060
